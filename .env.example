# ---- LLM（OpenAI 兼容接口）----
# mock：本地前端联调，不请求真实模型
# openai：vLLM / 百炼兼容接口
LLM_PROVIDER=mock
# 私有化 vLLM：http://<gpu-host>:8000/v1
# 百炼降级：https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_BASE=http://127.0.0.1:8000/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash-0731
LLM_DISABLE_THINKING=true

# 降级备份（主服务熔断后切换，留空则不降级）
LLM_FALLBACK_API_BASE=
LLM_FALLBACK_API_KEY=

# ---- 数字人 ----
LIVETALKING_BASE=http://127.0.0.1:8010
AVATAR_ID=wav2lip256_avatar1

# ---- 语音（Qwen3-Omni）----
# text：浏览器口述 + LiveTalking 内置 TTS（默认，mock 可跑）
# omni：浏览器 PCM → Omni /v1/realtime 转写 → 口播音频 → /humanaudio
VOICE_MODE=text
# Realtime 用 ws://，HTTP chat 备用会自动换成 http://
OMNI_API_BASE=http://127.0.0.1:8091
OMNI_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct
OMNI_SPEAKER=chelsie

# ---- RAG ----
# 留空则用进程内嵌 Qdrant（本地文件，无需 Docker）
QDRANT_URL=
QDRANT_PATH=./data/qdrant
# hash（离线开发用）/ bge-m3 / dashscope
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ---- 服务 ----
HOST=127.0.0.1
PORT=8090
SQLITE_PATH=./data/interview.db

# Debug 模式默认值（会话可单独开关）
DEBUG_DEFAULT=false
