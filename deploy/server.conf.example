# 私有化 GPU 服务器部署配置模板
# 用法：cp server.conf.example server.conf，然后填入真实值
# server.conf 已被 .gitignore 排除，不会上传 GitHub

REMOTE_HOST=        # GPU 服务器地址
REMOTE_PORT=22      # SSH 端口
REMOTE_USER=        # 登录用户
REMOTE_PASS=        # 登录密码（或改用密钥）
REMOTE_DIR=         # 远端部署目录，如 /home/<user>/virtual-interviewer

VLLM_PORT=8000      # vLLM 推理服务端口
LIVETALKING_PORT=8010
APP_PORT=8090
