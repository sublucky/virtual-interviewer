# 私有化 GPU 服务器部署配置模板
# 用法：cp server.conf.example server.conf，然后填入真实值
# server.conf 已被 .gitignore 排除，不会上传 GitHub

REMOTE_HOST=        # GPU 服务器地址
REMOTE_PORT=22      # SSH 端口
REMOTE_USER=        # 登录用户
REMOTE_PASS=        # 登录密码（或改用密钥）
REMOTE_DIR=         # 远端部署目录，如 /home/<user>/virtual-interviewer

VLLM_PORT=8000      # 文本 LLM（DeepSeek 等）端口，可选
LIVETALKING_PORT=8010
APP_PORT=8090

# Qwen3-Omni（vLLM-Omni，Realtime 需 --no-async-chunk）
OMNI_PORT=8091
OMNI_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct
OMNI_GPU_THINKER=0  # stage0 Thinker + API
OMNI_GPU_TALKER=1   # stage1 Talker + stage2 Code2Wav
OMNI_MASTER_PORT=26000
LIVETALKING_GPU=0   # 与 Omni 争抢时改为空闲卡，或改用 ultralight
